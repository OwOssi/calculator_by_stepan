<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CalcBtnBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/btn_bg_num</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="CalcBtnNum" parent="CalcBtnBase">
        <item name="android:background">@drawable/btn_bg_num</item>
    </style>

    <style name="CalcBtnFunc" parent="CalcBtnBase">
        <item name="android:background">@drawable/btn_bg_func</item>
        <item name="android:textColor">#1C1C1E</item>
    </style>

    <style name="CalcBtnOp" parent="CalcBtnBase">
        <item name="android:background">@drawable/btn_bg_op</item>
    </style>

    <style name="CalcBtnEq" parent="CalcBtnBase">
        <item name="android:background">@drawable/btn_bg_eq</item>
    </style>

</resources>
